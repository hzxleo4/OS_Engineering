#
# Revise $OSLAB_PATH to your path
#
romimage: file=$OSLAB_PATH/bochs/BIOS-bochs-latest
megs: 32
vgaromimage: file=$OSLAB_PATH/bochs/VGABIOS-lgpl-latest
floppya: 1_44="./Image", status=inserted
boot: a
log: ./LOG-bochsout.txt
#parport1: enable=0
vga_update_interval: 300000
keyboard_serial_delay: 200
keyboard_paste_delay: 100000
#floppy_command_delay: 50000
cpu: count=1, ips=4000000
mouse: enabled=0
private_colormap: enabled=0
fullscreen: enabled=0
screenmode: name="sample"
i440fxsupport: enabled=0

# hard disk
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
# !! Remember to change these if the hd img is changed:
#    1. include/sys/config.h::MINOR_BOOT
#    2. boot/include/load.inc::ROOT_BASE
#    3. Makefile::HD
#    4. commands/Makefile::HD
ata0-master: type=disk, path="80m.img", mode=flat, cylinders=162, heads=16, spt=63
#ata0-master: type=disk, path="80m.img", mode=flat, cylinders=162, heads=16, spt=63
